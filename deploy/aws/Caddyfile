{
	email {$ACME_EMAIL}
	grace_period 100s
}

{$API_DOMAIN} {
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy api:8000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 85s
		}
	}
	# No access log: URLs/query strings can contain financial filters.
}
