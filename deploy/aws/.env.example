# Copy to deploy/aws/.env, chmod 600, and fill on the server only.
# Docker Compose 2.30+ is required for raw env_file support (preserves $ in secrets).
API_DOMAIN=api.example.com
ACME_EMAIL=owner@example.com
# Tag each release so the previous image remains available for rollback.
BACKEND_IMAGE=buywise-backend:launch-1
ENVIRONMENT=production
BEDROCK_API_KEY=replace-on-server
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=minimax.minimax-m2.5
SUPABASE_URL=https://your-project-ref.supabase.co
# Session pooler, port 5432, from the project's Connect dialog. URL-encode password.
# No sslmode query parameter: DB_SSL_VERIFY configures asyncpg TLS instead.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
DB_SSL_VERIFY=true
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
CHAT_MAX_CONCURRENT=4
# Raw env_file retains these JSON quotes; do not wrap the whole value in quotes.
CORS_ALLOW_ORIGINS=["https://app.example.com"]
# Required for account deletion. Never put it in clients or image build arguments.
SUPABASE_SERVICE_ROLE_KEY=replace-on-server
