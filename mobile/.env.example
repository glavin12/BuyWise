# Copy to .env.local (gitignored) and fill in. Reload the app after changes.

# Supabase project (same project the web app and backend use)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here

# FastAPI backend on your local network.
# Backend must be started with:
#   uv run uvicorn ai_service.main:app --reload --host 0.0.0.0
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# Optional Metro packager host if Expo Go selects the wrong network adapter.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.x.x

# Privacy policy and Terms pages (optional)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
