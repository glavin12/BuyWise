# Copy to .env.local (gitignored) and fill in. Reload the app after changes.

# Supabase project (same project the web app uses). The anon/publishable key is
# safe to ship in the client; never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here

# FastAPI backend. A phone on Wi-Fi cannot reach 127.0.0.1 -- use the PC's LAN IP
# (run `ipconfig`) and start the backend with --host 0.0.0.0:
#   uv run uvicorn ai_service.main:app --reload --host 0.0.0.0
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# Privacy policy and Terms pages (public https URLs the owner hosts). Optional: a link whose URL is
# not set is simply not shown. The stores require a privacy policy, so set the first before release.
# Restart Expo with `npx expo start -c` after changing these.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
