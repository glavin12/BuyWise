# BuyWise AI Service

# Groq API Key
GROQ_API_KEY=your-groq-api-key-here

# Model Configuration
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.7

# Supabase PostgreSQL
# A postgresql:// URL is accepted and normalized to postgresql+asyncpg:// at runtime.
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Server
HOST=0.0.0.0
PORT=8000
