# BuyWise AI Service

# Runtime environment: development | testing | staging | production.
# Controls registration of development-only utilities ONLY (/dev/* routes and
# the /docs, /redoc, /openapi.json API docs). Must never branch business logic,
# auth, DB queries, or AI behavior. If unset the app runs as production (fail
# closed), so keep ENVIRONMENT=development for local work and set production
# (or leave it unset) on any server.
ENVIRONMENT=development

# Amazon Bedrock API key (server-only; use the same region the key was created in).
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=minimax.minimax-m2.5

# Model Configuration
TEMPERATURE=0.3
# Last N chat messages sent to the agent each turn (default 30).
# MAX_CONVERSATION_HISTORY=30

# Supabase PostgreSQL
# A postgresql:// URL is accepted and normalized to postgresql+asyncpg:// at runtime.
# The direct host db.<ref>.supabase.co is IPv6 only. Without IPv6 ("Network is unreachable") use the Session
# pooler from Supabase > Connect instead: postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432
# (not the transaction pooler on 6543). Write any @ # / : in the password URL-encoded, e.g. @ as %40.
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Read only when DATABASE_URL is blank (an alternative name for the same thing).
# SUPABASE_DATABASE_URL=
# Ping each pooled connection before use (default true). It replaces connections the pooler dropped, at 3
# round trips per request: keep it on where the backend runs next to the database, set false for local work
# against a distant one.
# DB_POOL_PRE_PING=true
# Per worker: total ceiling = workers * replicas * (pool size + overflow).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# Verify the database TLS certificate and hostname on AWS.
# DB_SSL_VERIFY=true

# Server
HOST=0.0.0.0
PORT=8000
# JSON array of allowed web origins. Mobile native requests do not use CORS.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
# Per worker; excess chat requests get 503 + Retry-After before any chat is saved.
# CHAT_MAX_CONCURRENT=4

# --- Supabase Auth (JWT verification via JWKS) ---
# Auth is handled entirely by Supabase Auth on the frontend; this backend only
# VERIFIES Supabase-issued access tokens. No password/user creation happens here.
# Verification uses the project's JWKS (asymmetric public keys) — no HS256
# shared secret is stored on the backend.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon key — used ONLY by the dev /dev/token helper to relay
# credentials to Supabase Auth (auth module does NOT use it).
SUPABASE_ANON_KEY=

# Optional overrides (defaults shown):
# SUPABASE_JWT_ISSUER=   # blank => derived as SUPABASE_URL + /auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ALGORITHMS=ES256,RS256   # asymmetric algs only; key selected by kid
# JWKS_CACHE_TTL_SECONDS=300            # keep <= Supabase's 10-min edge cache

# --- Account deletion (DELETE /api/v1/profile) ---
# Needed to delete the user's Supabase login as well as their data. Without it that endpoint answers 503 and
# deletes nothing. Use the project's secret key (sb_secret_...) or the legacy service_role key from Supabase >
# Settings > API Keys. It bypasses all access rules: set it on the backend host only (never in mobile/ or
# frontend/, never commit it).
# SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (in memory, per user; defaults shown) ---
# slowapi syntax "N/period" (period = second|minute|hour|day). RATE_LIMIT_ENABLED=false turns all limits off.
# RATE_LIMIT_ENABLED=true
# CHAT_RATE_LIMIT=20/minute
# CONVERSATIONS_RATE_LIMIT=60/minute
# PROFILE_RATE_LIMIT=30/minute
# FINANCIAL_RATE_LIMIT=60/minute
# HEALTH_RATE_LIMIT=60/minute
# DEV_RATE_LIMIT=10/minute
